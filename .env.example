# Turso Database Configuration (Opsional - Bisa diisi langsung lewat Settings modal di web)
# Dapatkan dari: turso db show <db-name> --url
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io

# Dapatkan dari: turso db tokens create <db-name>
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here
